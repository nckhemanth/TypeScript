{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Paste screenshot to markdown",
      "type": "shell",
      "command": "${workspaceFolder}/../scripts/paste-md-screenshot.sh",
      "args": ["${file}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
